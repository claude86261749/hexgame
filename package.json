{
  "name": "paper-diagrams",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "probe": "tsx server/probe.ts",
    "ingest": "tsx server/cli.ts",
    "eval": "tsx eval/run.ts",
    "shots": "tsx eval/shots.ts",
    "fetch:arxiv": "node scripts/arxiv2md.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "eval:live": "tsx eval/live.ts"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.12",
    "mdast-util-to-string": "^4.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "linkedom": "^0.18.13",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "turndown": "^7.2.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}